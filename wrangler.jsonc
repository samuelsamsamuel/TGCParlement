// Hémicycle : Worker Cloudflare (site statique + API) et base D1.
// Publié par Cloudflare Workers Builds à chaque commit sur main (commande « npx wrangler deploy »).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeu",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Seules les adresses de l'API passent par le Worker ; le reste du site est servi directement
    "run_worker_first": ["/api/*"]
  },
  // Identifiant du déploiement en cours : donné dans chaque réponse de l'API (x-version), pour que les pages ouvertes
  // avant un déploiement se rechargent
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hemicycle",
      // Base D1 « hemicycle » (tableau de bord Cloudflare, Storage & Databases > D1).
      // Les tables sont créées par le Worker à sa première requête.
      "database_id": "f10a3460-69ab-4b65-b56a-90c049f02c9c"
    }
  ],
  // Toutes les heures : notification « réserve pleine » aux joueurs abonnés (surveillerReserves)
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
